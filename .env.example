# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# true = ordinary roster calls are simulated. Separately enabled, presenter-gated
# rehearsal routes can still call their fixed consenting destinations.
MOCK_RETELL=true

# Retell
RETELL_API_KEY=
# Optional separate Retell webhook signing key; falls back to RETELL_API_KEY.
RETELL_WEBHOOK_KEY=
RETELL_AGENT_ID=
RETELL_FROM_NUMBER=
# Server-only fixed destination for the on-call nurse. E.164; not 911/emergency services.
# Do not use the agent's own number. Configure/rehearse with a consenting teammate.
# Local configuration does not prove the published Retell agent has this tool.
ON_CALL_NURSE_PHONE=
# Dedicated check-in agents, with no research or custom tools.
RETELL_DAILY_AGENT_ID=
RETELL_CRISIS_AGENT_ID=
# Optional Korean agents (P1). English agents remain the fallback.
RETELL_DAILY_KO_AGENT_ID=
RETELL_CRISIS_KO_AGENT_ID=
RETELL_VOICE_ID=
# Our separate Python acoustic service. Optional; transcripts still work without it.
ACOUSTIC_SERVICE_URL=http://127.0.0.1:8019
ACOUSTIC_API_KEY=
# Optional exact CDN hostnames from your Retell recording links (comma separated).
# Documented retellai.s3.us-west-2.amazonaws.com is already allowed.
RETELL_RECORDING_HOSTS=
# Leave empty for transcript-timing channel attribution. Only set 0/1 after calibration.
RETELL_CALLER_AUDIO_CHANNEL=
# Public HTTPS app URL for agent setup and signed webhooks.
HEARTBEAT_PUBLIC_URL=
# One-person disaster rehearsal; ordinary sample replay stays mocked.
# Run scripts/configure-rehearsal-agent.ts to prepare a separate published agent.
HEARTBEAT_REHEARSAL_ENABLED=false
RETELL_REHEARSAL_AGENT_ID=
RETELL_REHEARSAL_AGENT_VERSION=
HEARTBEAT_REHEARSAL_PUBLIC_URL=
# Fixed E.164 destination. Add only when the teammate is ready to rehearse.
HEARTBEAT_REHEARSAL_PHONE=
# Private random presenter key, at least 24 characters; never a NEXT_PUBLIC variable.
HEARTBEAT_REHEARSAL_TOKEN=
# Local restricted callback proxy; keep the full app off the public tunnel.
HEARTBEAT_REHEARSAL_APP_URL=http://127.0.0.1:3018
HEARTBEAT_REHEARSAL_PROXY_PORT=3020
# Keep true for the hackathon: client display identities are fictional.
FICTIONAL_CLIENTS=true

# Live research + 3–5 delegated research agents (server only)
EXA_API_KEY=
# Public HTTPS address serving /api/retell/tools and /api/retell/webhook
VOICE_PUBLIC_URL=
# Optional separate Retell agent; configure it with the same delegated-task prompt
RETELL_DELEGATE_AGENT_ID=
# Approved outbound directory. Set real, authorized contacts before using call_contact.
# JSON array of { "id": "service-desk", "name": "Service desk", "phone": "+...", "description": "Public service questions" }
VOICE_OUTBOUND_CONTACTS=[]

# Optional live PHONE rehearsal for /prescription (fictional case; consenting teammates).
# Live browser source rooms work locally with no provider keys.
PRESCRIPTION_PUBLIC_URL=
# JSON map: { "pharmacy": "+...", "insurer": "+...", "clinic": "+..." }
PRESCRIPTION_DEMO_CONTACTS={}
# A private random token at least 24 characters long, required before dialing.
PRESCRIPTION_DEMO_CALL_TOKEN=
# Explicit opt-in if hosting the rehearsal backend in a production environment.
PRESCRIPTION_DEMO_ENABLED=false

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
COORDINATOR_PHONE=

# retell (llm is a compatibility alias for the same structured Retell evidence)
CLASSIFIER=retell

# 1 = real 5 min ladder steps. 0.05 = about 15 sec
DEMO_TIME_SCALE=0.05
AGENCY_NAME=Sunrise Home Care

# Where scripts/fake-webhook.ts sends requests
APP_URL=http://localhost:3017

# Optional separately hosted read-only LA map (local: http://localhost:5175/heartbeat)
NEXT_PUBLIC_HEARTBEAT_MAP_URL=
