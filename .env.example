# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# true = no real calls. Send results with scripts/fake-webhook.ts
MOCK_RETELL=true

# Retell
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_FROM_NUMBER=

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
COORDINATOR_PHONE=

# retell or llm
CLASSIFIER=retell
# Only if CLASSIFIER=llm
LLM_API_KEY=

# 1 = real 5 min ladder steps. 0.05 = about 15 sec
DEMO_TIME_SCALE=0.05
AGENCY_NAME=Sunrise Home Care

# Where scripts/fake-webhook.ts sends requests
APP_URL=http://localhost:3000
