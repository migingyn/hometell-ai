# Copy to .env.local and fill in. Never commit .env or .env.local.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# true = no real calls. POST /api/clients/:id/call makes a mock call id instead.
MOCK_RETELL=true

# Retell
RETELL_API_KEY=your-retell-api-key
# The Retell API key with the webhook badge. Retell signs webhooks with it. Empty uses RETELL_API_KEY.
RETELL_WEBHOOK_KEY=
RETELL_AGENT_ID=agent_88c42c8831666ec6ef1a5b127b
RETELL_FROM_NUMBER=+16264635691
# Your ngrok or deployed URL. Paste {PUBLIC_BASE_URL}/retell-webhook into Retell.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app
# true skips x-retell-signature checks. Local testing only.
SKIP_SIGNATURE_CHECK=false

AGENCY_NAME=Sunrise Home Care
# A call still open this long raises an open_line alert. Use 1 for the demo.
OPEN_LINE_MINUTES=4
# Comma separated teammate phones in E.164 for scripts/seed.ts
SEED_PHONES=
# The separate frontend dev server, allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173

# The agent's transfer_to_nurse tool dials this. Falls back to FRONT_DESK_PHONE.
NURSE_PHONE=

# Optional. Texts the front desk on every alert when all four are set.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FRONT_DESK_PHONE=
