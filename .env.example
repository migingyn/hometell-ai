# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# true = no real calls. Send results with scripts/fake-webhook.ts
MOCK_RETELL=true

# Retell
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_FROM_NUMBER=
# Dedicated check-in agents, with no research or custom tools.
RETELL_DAILY_AGENT_ID=
RETELL_CRISIS_AGENT_ID=
# Optional Korean agents (P1). English agents remain the fallback.
RETELL_DAILY_KO_AGENT_ID=
RETELL_CRISIS_KO_AGENT_ID=
RETELL_VOICE_ID=
# Public HTTPS app URL for agent setup and signed webhooks.
HEARTBEAT_PUBLIC_URL=
# Keep true for the hackathon: client display identities are fictional.
FICTIONAL_CLIENTS=true

# Live research + 3–5 delegated research agents (server only)
EXA_API_KEY=
# Public HTTPS address serving /api/retell/tools and /api/retell/webhook
VOICE_PUBLIC_URL=
# Optional separate Retell agent; configure it with the same delegated-task prompt
RETELL_DELEGATE_AGENT_ID=
# Approved outbound directory. Set real, authorized contacts before using call_contact.
# JSON array of { "id": "service-desk", "name": "Service desk", "phone": "+...", "description": "Public service questions" }
VOICE_OUTBOUND_CONTACTS=[]

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
COORDINATOR_PHONE=

# retell (llm is a compatibility alias for the same structured Retell evidence)
CLASSIFIER=retell

# 1 = real 5 min ladder steps. 0.05 = about 15 sec
DEMO_TIME_SCALE=0.05
AGENCY_NAME=Sunrise Home Care

# Where scripts/fake-webhook.ts sends requests
APP_URL=http://localhost:3017

# Optional separately hosted read-only LA map (local: http://localhost:5175/heartbeat)
NEXT_PUBLIC_HEARTBEAT_MAP_URL=
